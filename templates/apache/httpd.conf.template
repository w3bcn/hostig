# Generado por Hostig. No editar a mano: se regenera (ADR 0005).

Define SRVROOT "{{SERVER_ROOT}}"
ServerRoot "${SRVROOT}"
Listen 127.0.0.1:{{HTTP_PORT}}
ServerName 127.0.0.1:{{HTTP_PORT}}
ServerAdmin hostig@localhost
PidFile "{{PID_FILE}}"

LoadModule authz_core_module modules/mod_authz_core.so
LoadModule alias_module modules/mod_alias.so
LoadModule dir_module modules/mod_dir.so
LoadModule headers_module modules/mod_headers.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule mime_module modules/mod_mime.so
LoadModule proxy_module modules/mod_proxy.so
LoadModule proxy_fcgi_module modules/mod_proxy_fcgi.so
LoadModule proxy_balancer_module modules/mod_proxy_balancer.so
LoadModule slotmem_shm_module modules/mod_slotmem_shm.so
LoadModule lbmethod_byrequests_module modules/mod_lbmethod_byrequests.so
LoadModule rewrite_module modules/mod_rewrite.so

TypesConfig conf/mime.types

LogFormat "%h %l %u %t \"%r\" %>s %b" common
ErrorLog "{{ERROR_LOG}}"
LogLevel warn
CustomLog "{{ACCESS_LOG}}" common

ProxyRequests Off
ProxyPreserveHost On
# php-cgi (no FPM): GENERIC evita el prefijo proxy:fcgi:// y el quirks de FPM.
ProxyFCGIBackendType GENERIC
# Windows + php-cgi: el worker fcgi://host:port/ + path absoluto produce
# SCRIPT_FILENAME=//C:/ruta/x.php (una o más barras delante de la unidad).
# Antes:  SCRIPT_FILENAME=//C:/ruta/x.php  (también /C:/… según el worker)
# Después: SCRIPT_FILENAME=C:/ruta/x.php
ProxyFCGISetEnvIf "reqenv('SCRIPT_FILENAME') =~ m#^/+([a-zA-Z]:/.*)$#" SCRIPT_FILENAME "$1"
ProxyFCGISetEnvIf "reqenv('PATH_TRANSLATED') =~ m#^/+([a-zA-Z]:/.*)$#" PATH_TRANSLATED "$1"

<Directory />
    AllowOverride none
    Require all denied
</Directory>

# Denegar .php con punto o espacio final (y mayúsculas): sin mod_rewrite,
# para que un RewriteEngine On del .htaccess del usuario no lo anule.
<FilesMatch "(?i)\.php[\. ]+$">
    Require all denied
</FilesMatch>
# URI con espacio / %20 / punto final (Windows a menudo normaliza el path a .php).
<LocationMatch "(?i)\.php(\.|%20| )(/|$)">
    Require all denied
</LocationMatch>

DocumentRoot "{{DOCUMENT_ROOT}}"
<Directory "{{DOCUMENT_ROOT}}">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
    DirectoryIndex index.php index.html

    # SetHandler + FilesMatch; (?i) cubre .PHP. Sin AddType, ProxyPassMatch ni router.
    # Sin RewriteRule de Hostig: los .htaccess del usuario se comportan como en Apache.
    <FilesMatch "(?i)\.php$">
        <If "-f %{REQUEST_FILENAME}">
            SetHandler "proxy:balancer://php/"
        </If>
    </FilesMatch>
</Directory>

# Health fuera del DocumentRoot: Alias evita que un .htaccess de WordPress
# (RewriteRule . /index.php) capture /__hostig/health bajo el DocumentRoot.
Alias /__hostig/health "{{HEALTH_PHP}}"
<Directory "{{HOSTIG_DIR}}">
    Options None
    AllowOverride None
    Require all granted
    <Files "health.php">
        SetHandler "proxy:balancer://php/"
        ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "{{HEALTH_PHP}}"
    </Files>
</Directory>

<Proxy "balancer://php">
{{BALANCER_MEMBERS}}
    ProxySet lbmethod=byrequests
</Proxy>

<VirtualHost 127.0.0.1:{{HTTP_PORT}}>
    DocumentRoot "{{DOCUMENT_ROOT}}"
    ProxyFCGIBackendType GENERIC
    ProxyFCGISetEnvIf "reqenv('SCRIPT_FILENAME') =~ m#^/+([a-zA-Z]:/.*)$#" SCRIPT_FILENAME "$1"
    ProxyFCGISetEnvIf "reqenv('PATH_TRANSLATED') =~ m#^/+([a-zA-Z]:/.*)$#" PATH_TRANSLATED "$1"

    <Directory "{{DOCUMENT_ROOT}}">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.php index.html
        <FilesMatch "(?i)\.php$">
            <If "-f %{REQUEST_FILENAME}">
                SetHandler "proxy:balancer://php/"
            </If>
        </FilesMatch>
    </Directory>
    Alias /__hostig/health "{{HEALTH_PHP}}"
    <Directory "{{HOSTIG_DIR}}">
        Options None
        AllowOverride None
        Require all granted
        <Files "health.php">
            SetHandler "proxy:balancer://php/"
            ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "{{HEALTH_PHP}}"
        </Files>
    </Directory>
</VirtualHost>
