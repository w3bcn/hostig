# Generado por Hostig. No editar a mano: se regenera (ADR 0005).

Define SRVROOT "{{SERVER_ROOT}}"
ServerRoot "${SRVROOT}"
Listen 127.0.0.1:{{HTTP_PORT}}
ServerName 127.0.0.1:{{HTTP_PORT}}
ServerAdmin hostig@localhost
PidFile "{{PID_FILE}}"

LoadModule authz_core_module modules/mod_authz_core.so
LoadModule alias_module modules/mod_alias.so
LoadModule dir_module modules/mod_dir.so
LoadModule headers_module modules/mod_headers.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule mime_module modules/mod_mime.so
LoadModule proxy_module modules/mod_proxy.so
LoadModule proxy_fcgi_module modules/mod_proxy_fcgi.so
LoadModule proxy_balancer_module modules/mod_proxy_balancer.so
LoadModule slotmem_shm_module modules/mod_slotmem_shm.so
LoadModule lbmethod_byrequests_module modules/mod_lbmethod_byrequests.so
LoadModule rewrite_module modules/mod_rewrite.so
LoadModule setenvif_module modules/mod_setenvif.so

TypesConfig conf/mime.types

LogFormat "%h %l %u %t \"%r\" %>s %b" common
ErrorLog "{{ERROR_LOG}}"
LogLevel warn
CustomLog "{{ACCESS_LOG}}" common

ProxyRequests Off
ProxyPreserveHost On
# php-cgi (no FPM): evita quirks de FPM en variables FastCGI.
ProxyFCGIBackendType GENERIC

<Directory />
    AllowOverride none
    Require all denied
</Directory>

DocumentRoot "{{DOCUMENT_ROOT}}"
<Directory "{{DOCUMENT_ROOT}}">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
    DirectoryIndex index.php index.html

    RewriteEngine On
    # Un .htaccess con RewriteEngine On no hereda reglas del Directory por
    # defecto; InheritDownBefore fuerza nuestras reglas (HOSTIG_SCRIPT) antes.
    RewriteOptions InheritDownBefore
    # Denegar .php con punto o espacio final: nunca como texto fuente.
    # En Windows el path se normaliza (strip de espacio/punto); mirar también
    # THE_REQUEST cruda (.php%20) para no ejecutar config.php por accidente.
    RewriteRule "(?i)\.php[\. ]$" "-" [F,L]
    RewriteCond %{THE_REQUEST} "(?i)\.php(%20|\.)(?:\s|\?)"
    RewriteRule "^" "-" [F,L]
    # Antes de SetHandler, guardar la ruta real (C:/...). Tras el proxy,
    # REQUEST_FILENAME pasa a ser proxy:balancer://... y php-cgi ve "/C:/...".
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule "(?i)\.php$" "-" [E=HOSTIG_SCRIPT:%{REQUEST_FILENAME},NC]
    # WordPress (u otro) en subcarpeta: /blog/slug → /blog/index.php antes de
    # que el .htaccess de la raíz lo robe hacia /index.php. Usar %1 de
    # REQUEST_URI (no $1 del path relativo): en el contexto /blog/ el $1 sería
    # el slug, no el nombre de la carpeta.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} "^/([A-Za-z0-9._-]+)/"
    RewriteCond %{DOCUMENT_ROOT}/%1 -d
    RewriteCond %{DOCUMENT_ROOT}/%1/index.php -f
    RewriteRule "^" "/%1/index.php" [E=HOSTIG_SCRIPT:%{DOCUMENT_ROOT}/%1/index.php,L]
    # Front controller en la raíz (.htaccess → /index.php): fijar HOSTIG_SCRIPT
    # en la primera pasada; el [E] sobrevive al redirect interno del [L].
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/index.php -f
    RewriteRule "^" "-" [E=HOSTIG_SCRIPT:%{DOCUMENT_ROOT}/index.php]

    # SetHandler + FilesMatch; (?i) cubre .PHP. Sin AddType ni router.
    <FilesMatch "(?i)\.php$">
        <If "-f %{REQUEST_FILENAME}">
            SetHandler "proxy:balancer://php/"
            ProxyFCGISetEnvIf "reqenv('HOSTIG_SCRIPT') !~ /^$/" SCRIPT_FILENAME "%{reqenv:HOSTIG_SCRIPT}"
        </If>
    </FilesMatch>
</Directory>

# Health fuera del DocumentRoot: Alias evita que un .htaccess de WordPress
# (RewriteRule . /index.php) capture /__hostig/health bajo el DocumentRoot.
Alias /__hostig/health "{{HEALTH_PHP}}"
<Directory "{{HOSTIG_DIR}}">
    Options None
    AllowOverride None
    Require all granted
    <Files "health.php">
        SetHandler "proxy:balancer://php/"
        ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "{{HEALTH_PHP}}"
    </Files>
</Directory>

<Proxy "balancer://php">
{{BALANCER_MEMBERS}}
    ProxySet lbmethod=byrequests
</Proxy>

<VirtualHost 127.0.0.1:{{HTTP_PORT}}>
    DocumentRoot "{{DOCUMENT_ROOT}}"
    # Contexto de servidor: se reevalúa tras [L] de .htaccess → /index.php.
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule "(?i)\.php$" "-" [E=HOSTIG_SCRIPT:%{REQUEST_FILENAME},NC]

    <Directory "{{DOCUMENT_ROOT}}">
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.php index.html
        RewriteEngine On
        RewriteOptions InheritDownBefore
        RewriteRule "(?i)\.php[\. ]$" "-" [F,L]
        RewriteCond %{THE_REQUEST} "(?i)\.php(%20|\.)(?:\s|\?)"
        RewriteRule "^" "-" [F,L]
        RewriteCond %{REQUEST_FILENAME} -f
        RewriteRule "(?i)\.php$" "-" [E=HOSTIG_SCRIPT:%{REQUEST_FILENAME},NC]
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteCond %{REQUEST_URI} "^/([A-Za-z0-9._-]+)/"
        RewriteCond %{DOCUMENT_ROOT}/%1 -d
        RewriteCond %{DOCUMENT_ROOT}/%1/index.php -f
        RewriteRule "^" "/%1/index.php" [E=HOSTIG_SCRIPT:%{DOCUMENT_ROOT}/%1/index.php,L]
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteCond %{DOCUMENT_ROOT}/index.php -f
        RewriteRule "^" "-" [E=HOSTIG_SCRIPT:%{DOCUMENT_ROOT}/index.php]
        <FilesMatch "(?i)\.php$">
            <If "-f %{REQUEST_FILENAME}">
                SetHandler "proxy:balancer://php/"
                ProxyFCGISetEnvIf "reqenv('HOSTIG_SCRIPT') !~ /^$/" SCRIPT_FILENAME "%{reqenv:HOSTIG_SCRIPT}"
            </If>
        </FilesMatch>
    </Directory>
    Alias /__hostig/health "{{HEALTH_PHP}}"
    <Directory "{{HOSTIG_DIR}}">
        Options None
        AllowOverride None
        Require all granted
        <Files "health.php">
            SetHandler "proxy:balancer://php/"
            ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "{{HEALTH_PHP}}"
        </Files>
    </Directory>
</VirtualHost>
